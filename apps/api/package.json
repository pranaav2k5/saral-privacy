{
  "name": "@saral/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Saral Privacy control-plane API (NestJS)",
  "main": "dist/main.js",
  "files": [
    "dist",
    "db"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @saral/api^... run build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @saral/api^... run build && pnpm run build && cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:migrate": "node dist/db/migrate-cli.js",
    "operator": "node dist/operator/main.js",
    "anchor": "node dist/audit/anchor-main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@saral/audit-chain": "workspace:*",
    "@saral/notice": "workspace:*",
    "@saral/receipts": "workspace:*",
    "@saral/schemas": "workspace:*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.3.1",
    "yaml": "^2.9.1"
  }
}
