# Copy to envs/backend.hcl and fill in the placeholders (no secrets belong in this file).
# The state bucket must already exist. use_lockfile enables S3-native state locking (Terraform >= 1.10).
bucket       = "saral-terraform-state-<account-id>"
key          = "saral-privacy/<env>/terraform.tfstate"
region       = "ap-south-1"
use_lockfile = true
encrypt      = true
